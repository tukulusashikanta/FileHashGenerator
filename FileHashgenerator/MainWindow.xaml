<Window x:Class="FileHashgenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileHashgenerator"
        mc:Ignorable="d"
        Title="File Hash Generator" Height="450" Width="800"
        Icon="pack://application:,,,/HashGenerator.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Content="Selected File:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="FilePathTextBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,5,0,5"/>
        <Button Content="Browse..." Grid.Row="0" Grid.Column="2" Margin="5,5,0,5" Click="BrowseFile_Click"/>

        <Label Content="Hashing Algorithm:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <ComboBox x:Name="HashAlgorithmComboBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" SelectedIndex="0">
            <ComboBoxItem Content="SHA256"/>
            <ComboBoxItem Content="MD5"/>
            <ComboBoxItem Content="SHA1"/>
        </ComboBox>

        <Button Content="Calculate Hash" Grid.Row="2" Grid.Column="1" Margin="0,5,0,5" Click="CalculateHash_Click"/>
        <Label Content="Hash Result:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="HashTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,5,0,5"/>

        <Button Content="Convert to Base64" Grid.Row="4" Grid.Column="1" Margin="0,5,0,5" Click="ConvertToBase64_Click"/>
        <Label Content="Base64 Encoded:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox x:Name="Base64TextBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" Margin="0,5,0,5"/>
    </Grid>
</Window>
